 1 file changed, 14 insertions(+), 12 deletions(-)

diff --git a/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java b/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java
index 050da3d..9e979e6 100644
--- a/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java
+++ b/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java
@@ -34,25 +34,27 @@ public class TurnHandler {
             return false;
         }
         Move move = parsed.get();
-        Square from = move.from();
-        Square to = move.to();
-        Piece piece = board.get(from);
-        if (piece == null || piece.isWhite() != whiteToMove) {
+        if (!isLegal(move)) {
             System.out.println("Illegal move: " + input);
             return false;
         }
-        Piece target = board.get(to);
-        if (target != null && target.isWhite() == piece.isWhite()) {
-            System.out.println("Illegal move: " + input);
+        Piece mover = board.get(move.from());
+        play(move);
+        announce(mover, move);
+        return true;
+    }
+
+    /** The right side is moving, it is not capturing its own piece, and the piece's rule allows it. */
+    private boolean isLegal(Move move) {
+        Piece piece = board.get(move.from());
+        if (piece == null || piece.isWhite() != whiteToMove) {
             return false;
         }
-        if (!piece.canMoveTo(board, from, to)) {
-            System.out.println("Illegal move: " + input);
+        Piece target = board.get(move.to());
+        if (target != null && target.isWhite() == piece.isWhite()) {
             return false;
         }
-        play(move);
-        announce(piece, move);
-        return true;
+        return piece.canMoveTo(board, move.from(), move.to());
     }
 
     /** Moves the piece, records the move, and hands the turn to the other side. */
