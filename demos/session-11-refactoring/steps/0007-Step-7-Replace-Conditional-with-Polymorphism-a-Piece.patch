diff --git a/src/main/java/edu/sfsu/csc413/refactoring/Bishop.java b/src/main/java/edu/sfsu/csc413/refactoring/Bishop.java
new file mode 100644
index 0000000..3a52877
--- /dev/null
+++ b/src/main/java/edu/sfsu/csc413/refactoring/Bishop.java
@@ -0,0 +1,15 @@
+package edu.sfsu.csc413.refactoring;
+
+public class Bishop extends Piece {
+
+    public Bishop(boolean white) {
+        super('B', white);
+    }
+
+    @Override
+    public boolean canMoveTo(Board board, Square from, Square to) {
+        int fileDelta = to.file() - from.file();
+        int rankDelta = to.rank() - from.rank();
+        return Math.abs(fileDelta) == Math.abs(rankDelta) && fileDelta != 0 && board.isPathClear(from, to);
+    }
+}
diff --git a/src/main/java/edu/sfsu/csc413/refactoring/Board.java b/src/main/java/edu/sfsu/csc413/refactoring/Board.java
