diff --git a/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java b/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java
new file mode 100644
index 0000000..d340c80
--- /dev/null
+++ b/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java
@@ -0,0 +1,20 @@
+package edu.sfsu.csc413.refactoring;
+
+public class Pawn extends Piece {
+
+    public Pawn(boolean white) {
+        super('P', white);
+    }
+
+    @Override
+    public boolean canMoveTo(Board board, Square from, Square to) {
+        int fileDelta = to.file() - from.file();
+        int rankDelta = to.rank() - from.rank();
+        int direction = isWhite() ? 1 : -1;
+        int startRank = isWhite() ? 1 : 6;
+        Piece target = board.get(to);
+        return (fileDelta == 0 && rankDelta == direction && target == null)
+                || (fileDelta == 0 && rankDelta == 2 * direction && from.rank() == startRank && target == null && board.get(new Square(from.file(), from.rank() + direction)) == null)
+                || (Math.abs(fileDelta) == 1 && rankDelta == direction && target != null && target.isWhite() != isWhite());
+    }
+}
