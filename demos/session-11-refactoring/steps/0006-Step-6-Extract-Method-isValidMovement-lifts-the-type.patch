 .../sfsu/csc413/refactoring/TurnHandler.java  | 27 +++++++++++--------
 1 file changed, 16 insertions(+), 11 deletions(-)

diff --git a/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java b/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java
index 31d5602..8133eb5 100644
--- a/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java
+++ b/src/main/java/edu/sfsu/csc413/refactoring/TurnHandler.java
@@ -46,6 +46,21 @@ public class TurnHandler {
             System.out.println("Illegal move: " + input);
             return false;
         }
+        if (!isValidMovement(piece, from, to, target)) {
+            System.out.println("Illegal move: " + input);
+            return false;
+        }
+        board.set(to, piece);
+        board.set(from, null);
+        history.add(move.notation());
+        whiteToMove = !whiteToMove;
+        System.out.println((piece.white ? "White" : "Black") + " plays " + input);
+        printer.print(board);
+        return true;
+    }
+
+    /** Whether the piece's own movement rule allows going from one square to the other. */
+    private boolean isValidMovement(Piece piece, Square from, Square to, Piece target) {
         int fileDelta = to.file() - from.file();
         int rankDelta = to.rank() - from.rank();
         boolean movementAllowed = false;
@@ -66,17 +81,7 @@ public class TurnHandler {
                     || (fileDelta == 0 && rankDelta == 2 * direction && from.rank() == startRank && target == null && board.get(new Square(from.file(), from.rank() + direction)) == null)
                     || (Math.abs(fileDelta) == 1 && rankDelta == direction && target != null && target.white != piece.white);
         }
-        if (!movementAllowed) {
-            System.out.println("Illegal move: " + input);
-            return false;
-        }
-        board.set(to, piece);
-        board.set(from, null);
-        history.add(move.notation());
-        whiteToMove = !whiteToMove;
-        System.out.println((piece.white ? "White" : "Black") + " plays " + input);
-        printer.print(board);
-        return true;
+        return movementAllowed;
     }
 
     /** Every square strictly between the two given squares is empty. */
