From a80c97918b50bce60c4f2518bc7a5cab1b651f8a Mon Sep 17 00:00:00 2001
From: CSC 413 demo <demo@example.com>
Date: Sun, 4 Oct 2026 21:39:26 -0700
Subject: [PATCH 08/10] Step 8: Decompose Conditional: the pawn rule becomes
 three named questions

---
 .../edu/sfsu/csc413/refactoring/Pawn.java     | 41 +++++++++++++++----
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java b/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java
index d340c80..b5b1fd5 100644
--- a/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java
+++ b/src/main/java/edu/sfsu/csc413/refactoring/Pawn.java
@@ -8,13 +8,40 @@ public class Pawn extends Piece {
 
     @Override
     public boolean canMoveTo(Board board, Square from, Square to) {
-        int fileDelta = to.file() - from.file();
-        int rankDelta = to.rank() - from.rank();
-        int direction = isWhite() ? 1 : -1;
-        int startRank = isWhite() ? 1 : 6;
+        return isSingleStep(board, from, to)
+                || isDoubleStepFromStart(board, from, to)
+                || isDiagonalCapture(board, from, to);
+    }
+
+    private boolean isSingleStep(Board board, Square from, Square to) {
+        return to.file() == from.file()
+                && to.rank() == from.rank() + forward()
+                && board.get(to) == null;
+    }
+
+    private boolean isDoubleStepFromStart(Board board, Square from, Square to) {
+        Square stepAhead = new Square(from.file(), from.rank() + forward());
+        return to.file() == from.file()
+                && to.rank() == from.rank() + 2 * forward()
+                && from.rank() == startRank()
+                && board.get(to) == null
+                && board.get(stepAhead) == null;
+    }
+
+    private boolean isDiagonalCapture(Board board, Square from, Square to) {
         Piece target = board.get(to);
-        return (fileDelta == 0 && rankDelta == direction && target == null)
-                || (fileDelta == 0 && rankDelta == 2 * direction && from.rank() == startRank && target == null && board.get(new Square(from.file(), from.rank() + direction)) == null)
-                || (Math.abs(fileDelta) == 1 && rankDelta == direction && target != null && target.isWhite() != isWhite());
+        return Math.abs(to.file() - from.file()) == 1
+                && to.rank() == from.rank() + forward()
+                && target != null
+                && target.isWhite() != isWhite();
+    }
+
+    /** +1 for White, who moves up the board; -1 for Black. */
+    private int forward() {
+        return isWhite() ? 1 : -1;
+    }
+
+    private int startRank() {
+        return isWhite() ? 1 : 6;
     }
 }
